    "# Her ihtimale karşı temiz bir başlangıç\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Veri setine çakışma riskine karşı özgün bir isim veriyoruz: restaurant_df\n",
    "restaurant_df = sns.load_dataset('tips')\n",
    "\n",
    "# Kontrol edelim\n",
    "print(restaurant_df.head())\n",
    "\n",
    "# Grafiği çizdirip kaydedelim\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.scatterplot(data=restaurant_df, x='total_bill', y='tip', hue='day', style='time', s=100)\n",
    "plt.title('Hesap Tutarı ve Bahşiş İlişkisi Analizi')\n",
    "plt.xlabel('Toplam Hesap ($)')\n",
    "plt.ylabel('Bahşiş ($)')\n",
    "\n",
    "# Bilgisayarına resim olarak kaydediyor\n",
    "plt.savefig('bahis_analizi.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
